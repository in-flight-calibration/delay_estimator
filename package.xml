<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>delay_estimator</name>
    <version>0.0.0</version>
    <description>Estimates the delay between the camera stream and autopilot telemetry.</description>
    <maintainer email="wggajda@gmail.com">Wojciech Gajda</maintainer>
    <license>TODO</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>eigen</depend>
    <depend>ifc_msgs</depend>
    <depend>ifc_tools</depend>
    <depend>libceres-dev</depend>
    <depend>libopencv-dev</depend>
    <depend>px4_msgs</depend>
    <depend>rclcpp</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
